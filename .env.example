# Public site origin used to resolve SEO and social metadata URLs after deployment.
NEXT_PUBLIC_SITE_URL=
# SMTP configuration for RFQ delivery. Keep every value server-side.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
RFQ_FROM_EMAIL=
RFQ_TO_EMAIL=
# Optional separate destination for privacy rights requests. If blank, requests go to RFQ_TO_EMAIL.
PRIVACY_TO_EMAIL=
